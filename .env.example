# Network drive path inside the container
# This should match the volume mount in docker-compose.yml
NETWORK_DRIVE_PATH=/downloads
API_KEY=your-secret-key-here

# Tumblr API app (https://www.tumblr.com/oauth/apps), used to find the image
# in shared Tumblr post links. The consumer key alone covers public blogs;
# the OAuth token (from a one-time approval of the app) adds login-only blogs
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_TOKEN_SECRET=

# Port the server listens on
PORT=3000

# Node environment
NODE_ENV=production
