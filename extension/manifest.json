{
  "manifest_version": 3,
  "name": "Image Downloader to Network Drive",
  "version": "1.8",
  "description": "Right-click on images to download them to your network drive, or collect a whole Tumblr tag, YouPic portfolio or page",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Collect photos"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "option-rightclick.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.tumblr.com/*",
        "https://*.tumblr.com/*"
      ],
      "js": [
        "tumblr-context.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
